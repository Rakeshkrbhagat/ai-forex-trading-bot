# Copy this file to .streamlit/secrets.toml (locally) OR paste its contents into
# the "Secrets" box of your app on Streamlit Community Cloud.
#
# Point the dashboard at your Render Spring Boot backend. Use the FULL https URL
# with no trailing slash and no /api suffix — the app appends /api/... itself.
FOREXBOT_BACKEND_URL = "https://ai-forex-trading-bot.onrender.com"

# Optional: bump the timeout, since Render free instances cold-start slowly.
# FOREXBOT_API_TIMEOUT = "30"

