# Copy to .env (same folder as mt5_bridge.py) and adjust values.
# The bridge auto-loads this file if python-dotenv is installed.

# ---- Cloud backend (Render) ----
# Live Spring Boot backend. The bridge derives the WebSocket URL from this
# (https:// -> wss://, appending /ws/bridge) unless BACKEND_WS_URL is set.
BACKEND_URL=https://ai-forex-trading-bot-gogi.onrender.com
# Optional explicit override of the WebSocket endpoint:
# BACKEND_WS_URL=wss://ai-forex-trading-bot-gogi.onrender.com/ws/bridge

# Shared bearer token that must match the backend (authorizes this bridge).
MT5_BRIDGE_API_KEY=

# Unique identifier for this bridge instance shown on the dashboard.
BRIDGE_ID=local-mt5-bridge
# Seconds between account/margin telemetry pushes.
TELEMETRY_INTERVAL=15

# ---- Local REST server (optional manual calls) ----
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8090

# ---- MetaTrader 5 login (falls back to the attached terminal session) ----
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

